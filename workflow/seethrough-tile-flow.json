":"STRING","link":18},{"localized_name":"max_side","name":"max_side","shape":7,"type":"INT","widget":{"name":"max_side"},"link":null},{"localized_name":"show_parts","name":"show_parts","shape":7,"type":"BOOLEAN","widget":{"name":"show_parts"},"link":null}],"outputs":[{"localized_name":"preview","name":"preview","type":"IMAGE","links":[]}],"title":"⑤ 预览合并 PSD","properties":{"Node name for S&R":"STLU_PSDPreview","stlu_last_psd":"D:\\Development\\AI\\ComfyUI\\ComfyUI\\output\\SeeThrough\\我的自设\\merged.psd"},"widgets_values":[1600,true],"widgets_values_named":{"max_side":1600,"show_parts":true}},{"id":10,"type":"MarkdownNote","pos":[-560,60],"size":[540,900],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"透明版说明","properties":{"Node name for S&R":"MarkdownNote"},"widgets_values":["# SeeThrough 四步分块流水线（透明版）\n\n这一版把原来的「盲盒节点」全部摊开：每个阶段都是一个子图，子图里每一步都是一个可见节点，\n点开就能看到内部发生了什么。旧文件 `seethrough-四步分块流水线-引导.json` 保持原样，随时可回退。\n\n## 只改这里：①-0 用户输入（参数包）\n面板和全部参数都在这一个节点上，但它自己什么都不算，只把参数打包成 `settings` 往下传。\n\n- **① 计划与切块**：规划网格 → 选块 → 上下文外扩 → 准备运行 → 裁剪。\n  其中只有「准备运行」会写盘（写 generation.json、参数变了清空旧结果）。\n- **② 顺序拆层**：唯一必须保留 Python 的循环——第 N 块要看到第 N-1 块生成的像素。\n  `guided_inputs` / `composites` 两个输出接在外层预览上，能直接看每块实际吃了什么。\n- **③ 存盘**：恢复锁定部件（只读）→ 写单块 PSD → 写单块分层 PNG → 存原图 → 写清单。\n- **④ 合并**：接缝归属 / 缩放 / 整部件例外 / 分层组装是一整块算法，保留为单节点；\n  `report` 输出列出它做了什么。\n- **⑤ 预览**：合并 PSD 的全身总览 + 按块 / 按部位分组。② 的 `guided_inputs`\n  和 `indices` 接在这一个节点上，「按块」每一行多一张「输入」——引导回填后\n  真正送进模型的那张图（只有本次跑过的块才有）。\n\n## 用法\n1. 在 LoadImage 选图，在 ①-0 面板勾选要跑的块（未勾选不跑 GPU）。\n2. 按 **Queue**，①②③④ 自动接力。\n3. 结果在 `output/<根目录>/<分类?>/`。\n\n## 调试入口\n- 生成中途不再弹预览：每块实际喂给模型的输入就在 ⑤ 面板「按块」的「输入」列，\n  合成结果就是同一行的「合并」图和拆分图层。\n- 想手动重跑合并：④ 子图单独 Queue 即可（输入 merge_doc 来自 ③）。\n"],"widgets_values_named":{"text":"# SeeThrough 四步分块流水线（透明版）\n\n这一版把原来的「盲盒节点」全部摊开：每个阶段都是一个子图，子图里每一步都是一个可见节点，\n点开就能看到内部发生了什么。旧文件 `seethrough-四步分块流水线-引导.json` 保持原样，随时可回退。\n\n## 只改这里：①-0 用户输入（参数包）\n面板和全部参数都在这一个节点上，但它自己什么都不算，只把参数打包成 `settings` 往下传。\n\n- **① 计划与切块**：规划网格 → 选块 → 上下文外扩 → 准备运行 → 裁剪。\n  其中只有「准备运行」会写盘（写 generation.json、参数变了清空旧结果）。\n- **② 顺序拆层**：唯一必须保留 Python 的循环——第 N 块要看到第 N-1 块生成的像素。\n  `guided_inputs` / `composites` 两个输出接在外层预览上，能直接看每块实际吃了什么。\n- **③ 存盘**：恢复锁定部件（只读）→ 写单块 PSD → 写单块分层 PNG → 存原图 → 写清单。\n- **④ 合并**：接缝归属 / 缩放 / 整部件例外 / 分层组装是一整块算法，保留为单节点；\n  `report` 输出列出它做了什么。\n- **⑤ 预览**：合并 PSD 的全身总览 + 按块 / 按部位分组。② 的 `guided_inputs`\n  和 `indices` 接在这一个节点上，「按块」每一行多一张「输入」——引导回填后\n  真正送进模型的那张图（只有本次跑过的块才有）。\n\n## 用法\n1. 在 LoadImage 选图，在 ①-0 面板勾选要跑的块（未勾选不跑 GPU）。\n2. 按 **Queue**，①②③④ 自动接力。\n3. 结果在 `output/<根目录>/<分类?>/`。\n\n## 调试入口\n- 生成中途不再弹预览：每块实际喂给模型的输入就在 ⑤ 面板「按块」的「输入」列，\n  合成结果就是同一行的「合并」图和拆分图层。\n- 想手动重跑合并：④ 子图单独 Queue 即可（输入 merge_doc 来自 ③）。\n"},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,2,0,"IMAGE"],[2,1,0,5,0,"IMAGE"],[3,2,0,5,1,"STLU_SETTINGS"],[4,3,0,5,2,"SEETHROUGH_LAYERDIFF_MODEL"],[5,4,0,5,3,"SEETHROUGH_DEPTH_MODEL"],[6,5,1,6,0,"IMAGE"],[7,5,2,6,1,"STRING"],[8,5,0,6,2,"STLU_PLAN"],[9,3,0,6,3,"SEETHROUGH_LAYERDIFF_MODEL"],[10,4,0,6,4,"SEETHROUGH_DEPTH_MODEL"],[11,6,0,7,0,"SEETHROUGH_PARTS"],[12,6,1,7,1,"STRING"],[13,5,0,7,2,"STLU_PLAN"],[14,1,0,7,3,"IMAGE"],[15,7,1,8,0,"STLU_MERGE"],[16,8,0,9,0,"STRING"],[17,6,2,9,1,"IMAGE"],[18,6,1,9,2,"STRING"]],"groups":[{"id":1,"title":"① 用户输入（只改这里）","bounding":[0,0,640,1960],"color":"#4a7a5a","flags":{}},{"id":2,"title":"模型（默认即可）","bounding":[640,20,380,420],"color":"#444","flags":{}},{"id":3,"title":"① 计划与切块","bounding":[640,480,480,340],"color":"#3f789e","flags":{}},{"id":4,"title":"② 顺序拆层（循环保留 Python）","bounding":[1160,480,480,340],"color":"#3f789e","flags":{}},{"id":5,"title":"③ 存盘","bounding":[640,840,480,288.32001342773424],"color":"#b58b2a","flags":{}},{"id":6,"title":"④ 合并","bounding":[1163.5999999999997,847.6000000000001,480,280],"color":"#a1309b","flags":{}},{"id":8,"title":"⑤ 预览合并 PSD","bounding":[639.9652196985492,1142.7816215014507,940,780],"color":"#444","flags":{}}],"definitions":{"subgraphs":[{"id":"966081a1-686c-5517-a80e-55fe732f04b9","version":1,"state":{"lastGroupId